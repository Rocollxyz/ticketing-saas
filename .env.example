# Copiar a .env (no se versiona). Valores de desarrollo local.

# Conexión de la aplicación: rol SIN BYPASSRLS (§7 ARCHITECTURE.md).
# En local usamos el superusuario por simplicidad de arranque, pero el rol de app
# real (app_user) se crea en la primera migración y es el que debe usar la API.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticketing

# Conexión que usa la API: rol app_user SIN BYPASSRLS → sujeto a RLS (§7).
# En dev el login se da con scripts/dev-app-user-login.sql.
DATABASE_URL_APP=postgres://app_user:app_user_dev@localhost:5432/ticketing

REDIS_URL=redis://localhost:6379

NODE_ENV=development

# Secreto de firma JWT (en prod va al secret manager, §7)
JWT_SECRET=dev-insecure-secret-change-me

# ─── Pagos ───
# Pasarela de la TARJETA: stripe | redsys | fake (dev, sin cuenta).
PAYMENTS_PROVIDER=fake
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_PUBLISHABLE_KEY=pk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…

# Redsys (TPV virtual del banco): tarjeta y Bizum por redirección. Estos son los datos
# GENÉRICOS de pruebas que publica Redsys (entorno sis-t); en producción, los del banco.
# REDSYS_MERCHANT_CODE=999008881
# REDSYS_TERMINAL=1
# REDSYS_SECRET=sq7HjrUOBfKmC576ILgskD5srU870gJ7
# REDSYS_ENV=test
# REDSYS_BIZUM=1
# URL pública de la API (notificaciones de Redsys) y de la tienda (vuelta del comprador).
# PUBLIC_API_URL=http://localhost:3000
# SHOP_PUBLIC_URL=http://localhost:3001

# ─── Seguridad ───
# Clave maestra (32 bytes en base64) que cifra en reposo las claves de firma de los QR.
# Genera una con: openssl rand -base64 32. Si se pierde, los QR emitidos dejan de validar.
MASTER_KEY=
# Detrás de un proxy/balanceador: nº de saltos de confianza para leer la IP real (límites).
# TRUST_PROXY=1
